# Copy to .env (same folder as this file, the repo root) and fill in. .env is git-ignored; never commit a real key.
# You only need ONE provider. With no key the app runs offline on the cached answers in cache/llm/.

# --- Which provider? anthropic | openai | auto (auto = Anthropic if its key is set, else OpenAI) ---
SEAM_LLM_PROVIDER=auto

# --- OpenAI (or ANY OpenAI-compatible service) ---
OPENAI_API_KEY=paste-your-key-here
# Optional: another OpenAI-compatible endpoint (OpenRouter, Groq, Together, Azure, a local Ollama/vLLM ...).
# OPENAI_BASE_URL=https://api.openai.com/v1
#   OpenRouter: https://openrouter.ai/api/v1      Groq: https://api.groq.com/openai/v1      Ollama: http://localhost:11434/v1

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=paste-your-key-here

# Optional: model name. Defaults: openai -> gpt-4o, anthropic -> claude-opus-5-5
# SEAM_MODEL=gpt-4o
# Optional: set to "off" to force offline mode (cached LLM answers only) even with a key
# SEAM_LLM=on
